# Copy to .env and fill in values. Never commit .env.
APP_ENV=development
# Optional. Default: <repo root>/data/app.db, wherever you start the backend from.
# (Docker sets its own value in docker-compose.yml.)
# DATABASE_URL=sqlite:////absolute/path/to/app.db

# AI: used ONLY by the Email Generator (generator/); the inbox classifies with keyword
# rules and needs no key. Empty = not configured (Generate answers 503).
# The API is pay-as-you-go: set a monthly spend limit in the Anthropic Console first.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Seconds to wait for one Claude API call before giving up (must be > 0)
AI_TIMEOUT_SECONDS=30

# Shared secret for delivering emails to the inbox (POST /api/emails/ingest, header
# X-Ingest-Token). The generator service sends it; the inbox checks it. Empty = ingest
# disabled (HTTP 503). Generate a random one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_TOKEN=
# Generator service only: where the inbox is (dev default; Docker uses http://backend:8000)
# INBOX_URL=http://localhost:8000
# INBOX_TIMEOUT_SECONDS=10

# Calendar planning
APP_TIMEZONE=America/Toronto
WORK_HOURS=09:00-17:00

# Widgets
WEATHER_CITY=Toronto
NEWS_FEEDS=https://feeds.bbci.co.uk/news/rss.xml,https://hnrss.org/frontpage
