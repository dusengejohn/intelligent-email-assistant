# Copy to .env and fill in values. Never commit .env.
APP_ENV=development
DATABASE_URL=sqlite:///./data/app.db

# AI (optional at startup; AI features fall back / return 503 without a key)
# Leave empty to run without Claude: an empty value means "not configured".
# The API is pay-as-you-go: set a monthly spend limit in the Anthropic Console first.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Seconds to wait for one Claude API call before giving up (must be > 0)
AI_TIMEOUT_SECONDS=30

# Calendar planning
APP_TIMEZONE=America/Toronto
WORK_HOURS=09:00-17:00

# Widgets
WEATHER_CITY=Toronto
NEWS_FEEDS=https://feeds.bbci.co.uk/news/rss.xml,https://hnrss.org/frontpage
